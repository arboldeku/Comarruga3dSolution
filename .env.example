# Copia a .env y rellena. NUNCA subas .env al repositorio.

# Jev, API nativa de TypeSafe (https://docs.typesafe.ai/api)
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
# p. ej. jev-1.14.0 o el alias jev-latest
JEV_MODEL_ID=

# LLM generativo para explicaciones (opcional)
EXPLAINER_MODEL_ID=

# Zona de demo
ZONE_ID=comarruga_demo
DEM_PATH=data/raw/dem_comarruga.tif
