# Copia a .env y rellena. NUNCA subas .env al repositorio.

# Jev: formato de la API System One de TypeSafe (POST {JEV_BASE_URL}/v1/systemone; https://docs.typesafe.ai/api)
# Hackathon (modo sombra, 2026-11-10): JEV_BASE_URL=https://openrouter.ai/api y JEV_MODEL_ID=typesafe/jev-1.14
# Alternativa nativa (no probada con éxito): JEV_BASE_URL=https://api.typesafe.ai y JEV_MODEL_ID=jev-1.14.0
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
# p. ej. jev-1.14.0 o el alias jev-latest (hackathon: typesafe/jev-1.14)
JEV_MODEL_ID=

# LLM generativo para explicaciones (opcional)
EXPLAINER_MODEL_ID=

# Zona de demo
ZONE_ID=comarruga_demo
DEM_PATH=data/raw/dem_comarruga.tif
